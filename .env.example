# Copy to .env at the repository root. Never commit .env.

# TomTom developer key with Routing API and Geocoding API enabled.
TOMTOM_API_KEY=

# Django
DJANGO_SECRET_KEY=change-me-in-production
# Comma-separated. Production example: DJANGO_ALLOWED_HOSTS=203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
