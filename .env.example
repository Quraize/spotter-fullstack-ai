# Copy to .env at the repository root. Never commit .env.
# Local development reads this file through python-dotenv; docker-compose passes it to the backend container.

# TomTom developer key with Routing API and Geocoding API enabled.
TOMTOM_API_KEY=

# Django. In production (docker compose) all three below are required and checked by deploy/deploy.sh.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# Comma-separated hosts the app is reached at. Production example: DJANGO_ALLOWED_HOSTS=203.0.113.10
# (127.0.0.1 and localhost are always allowed for the container healthcheck.)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional, production only: host port nginx listens on (default 80).
# WEB_PORT=80
# Optional: INFO (default) or DEBUG for provider call details.
# DJANGO_LOG_LEVEL=INFO
# Optional, production only: where the backend caches provider responses. docker-compose sets it to the
# shared volume; set it only when running the prod settings outside compose.
# DJANGO_CACHE_DIR=/var/cache/spotter
